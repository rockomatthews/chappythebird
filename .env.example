# Stripe Payment Link URLs for the tip jar tiers.
# Create each one in the Stripe dashboard (Products → New → Payment link),
# paste the resulting URL here, then set the same vars in Vercel:
#   Project Settings → Environment Variables → add to Production.
# See STRIPE_SETUP.md for click-by-click steps.

# The Toss — $5 one-time
NEXT_PUBLIC_STRIPE_LINK_TOSS=

# The Perch — $10/month subscription
NEXT_PUBLIC_STRIPE_LINK_PERCH=

# The Patron — $50/month subscription
NEXT_PUBLIC_STRIPE_LINK_PATRON=

# Pay what you want — customer-set amount, $1 minimum, one-time
NEXT_PUBLIC_STRIPE_LINK_NAME_NUMBER=
